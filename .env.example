# Use an Atlas database user (not your Atlas account login). URL-encode special
# characters in the password and keep the /personal-site database name.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/personal-site?retryWrites=true&w=majority
DEV_USERNAME=change-me
DEV_PASSWORD=change-me
JWT_SECRET=replace-with-a-long-random-secret
GITHUB_TOKEN=
